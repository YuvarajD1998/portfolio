# Datum portfolio — environment variables (Sprint 01 §10).
# Copy to `.env.local` for local development. All values here are placeholders;
# no secret ships in the repo. Consumed through the typed loader in
# src/config/env.ts — never read process.env directly in app code.

# The canonical site origin, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment: development | preview | production.
# On Vercel this is derived automatically; set it locally only to simulate.
# NEXT_PUBLIC_APP_ENV=development

# Analytics — placeholder slot (Blueprint §18). Left empty in Sprint 01;
# Vercel Analytics is wired in a later sprint.
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
