# Cloudflare static-asset response headers (S16 §10).
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Fingerprinted build output (JS, CSS, next/font woff2 under _next/static/media)
# is content-hashed, so it can be cached forever and never revalidated.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Security hardening for every response — no design impact, no CSP that could
# block the self-hosted fonts/scripts already on the page (S16 §14).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()

# Non-fingerprinted, framework-generated static routes: cache for a day at the
# edge but let a deploy refresh them (they carry no content hash in the URL).
/icon.svg
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
/manifest.webmanifest
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800
