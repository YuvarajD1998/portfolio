{
  "name": "datum-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Yuvaraj's engineering portfolio — built on the Datum design system.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"*.{js,mjs,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "motion": "12.23.12",
    "lucide-react": "0.539.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "@radix-ui/react-slot": "1.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "tailwindcss": "4.1.11",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "typescript": "5.9.2",
    "@types/node": "22.17.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.33.0",
    "eslint-config-next": "15.4.6",
    "@eslint/eslintrc": "3.3.1",
    "@next/eslint-plugin-next": "15.4.6",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "@typescript-eslint/eslint-plugin": "8.39.0",
    "@typescript-eslint/parser": "8.39.0",
    "vitest": "3.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.4",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/user-event": "14.6.1"
  }
}
